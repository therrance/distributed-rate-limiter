# Copy to .env and adjust: cp .env.example .env
#
# All rate-limit values below are consumed by the nginx (OpenResty) service,
# the only enforcement point -- the Node backend does not rate limit. Changes
# need `docker compose up -d`; a plain `restart` won't pick up new env values.

# Host port nginx publishes. Change if 8080 is already in use.
NGINX_PORT=8080

# Anonymous requests, bucketed per client IP.
RATE_LIMIT=10
TIME_WINDOW=60

# Requests carrying an X-User-Id header, bucketed per user id.
USER_RATE_LIMIT=10
USER_TIME_WINDOW=60

# "false" (default): reject with 500 when Redis is unreachable. "true":
# allow requests through instead.
RATE_LIMIT_FAIL_OPEN=false

# Port the Node backend listens on inside its container (never published).
PORT=3000
